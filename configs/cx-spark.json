{
  "command": "codex",
  "model": "gpt-5.3-codex-spark",
  "effort": "xhigh",
  "args": [
    "--sandbox", "read-only",
    "--ask-for-approval", "never",
    "exec", "--skip-git-repo-check",
    "--ignore-user-config", "--ephemeral",
    "--color", "never"
  ],
  "env": {
    "CODEX_HOME": "${HOME}/.codex-ait"
  },
  "timeout_seconds": 900
}
