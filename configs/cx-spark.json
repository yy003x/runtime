{
  "type": "cli",
  "binary": "codex",
  "args": [
    "--sandbox",
    "read-only",
    "--ask-for-approval",
    "never",
    "-c",
    "model_reasoning_effort=xhigh",
    "exec",
    "--skip-git-repo-check",
    "--ignore-user-config",
    "--ephemeral",
    "--color",
    "never",
    "--model",
    "gpt-5.3-codex-spark"
  ],
  "env": {
    "CODEX_HOME": "${HOME}/.codex-ait"
  },
  "transport": "tty",
  "prompt_delivery": "argv"
}
