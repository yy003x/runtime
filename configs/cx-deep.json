{
  "command": "codex",
  "model": "gpt-5.6-sol",
  "effort": "max",
  "args": [
    "--search",
    "--sandbox", "danger-full-access",
    "--ask-for-approval", "never",
    "exec", "--skip-git-repo-check",
    "--ignore-user-config", "--ephemeral",
    "--color", "never"
  ],
  "env": {
    "CODEX_HOME": "${HOME}/.codex-ait"
  },
  "timeout_seconds": 900
}
