{
  "type": "api",
  "driver": "anthropic-compatible",
  "base_url": "https://dashscope.aliyuncs.com/apps/anthropic",
  "model": "glm-5.2",
  "auth": {
    "header": "x-api-key",
    "from_env": "BAILIAN_API_KEY"
  },
  "defaults": {
    "max_tokens": 16384
  },
  "context": {
    "window_tokens": 1048576,
    "reserved_output_tokens": 16384
  },
  "timeout": "50m"
}
