{
  "type": "cli",
  "command": "claude",
  "args": [
    "--permission-mode",
    "bypassPermissions",
    "--setting-sources",
    "project,local"
  ],
  "env": {
    "CLAUDE_CONFIG_DIR": "${HOME}/.claude-ait",
    "ANTHROPIC_BASE_URL": "https://tokenhub.tencentmaas.com",
    "ANTHROPIC_API_KEY": "${TENCENT_API_KEY}",
    "ANTHROPIC_MODEL": "kimi-k3",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "glm-5.3",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "minimax-m3",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "deepseek-v4-pro-202606",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "kimi-k3",
    "CLAUDE_CODE_SUBAGENT_MODEL": "kimi-k3",
    "CLAUDE_CODE_EFFORT_LEVEL": "max",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "1000000"
  }
}
