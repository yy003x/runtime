{
  "type": "cli",
  "label": "Claude Opus",
  "cli": {
    "driver": "claude",
    "executor": "command",
    "command": {
      "binary": "claude",
      "args": [],
      "model": "opus"
    },
    "runtime": {
      "prompt_delivery": "stdin",
      "managed_args": ["-p"]
    }
  },
  "presets": {
    "cc-aip": {
      "label": "Claude Opus（AIP 账号目录）",
      "cli": {
        "command": {
          "env": {
            "CLAUDE_CONFIG_DIR": "${HOME}/.claude-aip",
            "ANTHROPIC_BASE_URL": "https://api.kuaimaai.com.cn"
          },
          "env_unset_append": [
            "ANTHROPIC_AUTH_TOKEN"
          ]
        }
      }
    }
  }
}
