{
  "type": "cli",
  "label": "Claude Opus",
  "cli": {
    "driver": "claude",
    "executor": "command",
    "command": {
      "binary": "claude",
      "args": [],
      "model": "opus",
      "env": {
        "CLAUDE_CONFIG_DIR": "${HOME}/.claude-aip",
        "ANTHROPIC_BASE_URL": "https://api.kuaimaai.com.cn",
        "ANTHROPIC_API_KEY": "ANTHROPIC_API_KEY"
      },
      "env_unset": [
        "ANTHROPIC_AUTH_TOKEN"
      ]
    },
    "runtime": {
      "prompt_delivery": "stdin",
      "managed_args": ["-p"],
      "result_contract": "required"
    }
  }
}
