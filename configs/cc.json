{
  "type": "cli",
  "binary": "claude",
  "effort_adapter": "claude-flag",
  "args": [
    "--dangerously-skip-permissions"
  ],
  "env": {
    "CLAUDE_CONFIG_DIR": "${HOME}/.claude.aip",
    "ANTHROPIC_BASE_URL": "https://api.kuaimaai.com.cn",
    "ANTHROPIC_API_KEY": "${KMM_API_KEY}",
    "ANTHROPIC_AUTH_TOKEN": "${KMM_API_KEY}",
    "ANTHROPIC_MODEL": "claude-fable-5"
  },
  "transport": "tty",
  "prompt_delivery": "manual"
}
