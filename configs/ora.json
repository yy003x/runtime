{
  "type": "api",
  "label": "OpenRouter GLM-5.1 (Anthropic)",
  "timeout_seconds": 300,
  "api": {
    "protocol": "anthropic",
    "base_url": "https://openrouter.ai/api/v1",
    "model": "z-ai/glm-5.1",
    "api_key": "${OPENROUTER_API_KEY}",
    "auth": {
      "header": "Authorization",
      "prefix": "Bearer "
    },
    "headers": {
      "HTTP-Referer": "http://localhost",
      "X-OpenRouter-Title": "runtime-provider"
    }
  }
}
