{
  "type": "cli",
  "binary": "codex",
  "effort_adapter": "codex-config",
  "args": [
    "-c",
    "model_reasoning_effort=xhigh",
    "exec",
    "--skip-git-repo-check",
    "--ignore-user-config",
    "--ephemeral",
    "--color",
    "never",
    "--image",
    "${WB_RUNTIME_IMAGE_PATH}",
    "--model",
    "gpt-5.6-sol"
  ],
  "env": {
    "CODEX_HOME": "${HOME}/.codex-aip"
  },
  "transport": "tty",
  "prompt_delivery": "argv"
}
