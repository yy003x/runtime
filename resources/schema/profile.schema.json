{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yy003x/runtime/resources/schema/profile.schema.json",
  "title": "Runtime Profile",
  "oneOf": [
    {
      "title": "CLI Profile",
      "type": "object",
      "additionalProperties": false,
      "x-sn-adapter-grammar": true,
      "required": [
        "type",
        "command"
      ],
      "properties": {
        "type": {
          "const": "cli"
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "x-sn-max-bytes": 4096,
          "allOf": [
            {
              "pattern": "^[^\\x00]+$"
            },
            {
              "pattern": "(?:^|/)(?:codex|claude|grok)$"
            }
          ]
        },
        "args": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "string",
            "maxLength": 128000,
            "x-sn-max-bytes": 128000,
            "pattern": "^(?:[^$\\x00]|\\$+(?:\\{[A-Za-z_][A-Za-z0-9_]*\\}|[^$\\{\\x00]))*\\$*$"
          }
        },
        "env": {
          "type": "object",
          "maxProperties": 1024,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^=\\x00]*[^=\\x00\\s][^=\\x00]*$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128000,
            "x-sn-max-bytes": 128000,
            "pattern": "^(?:[^$\\x00]|\\$+(?:\\{[A-Za-z_][A-Za-z0-9_]*\\}|[^$\\{\\x00]))*\\$*$"
          }
        },
        "model": {
          "type": "string",
          "maxLength": 128000,
          "x-sn-max-bytes": 128000,
          "pattern": "^[^\\x00]*$"
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "prompt": {
          "type": "string",
          "maxLength": 128000,
          "x-sn-max-bytes": 128000,
          "pattern": "^[^\\x00]*$"
        },
        "cwd": {
          "type": "string",
          "maxLength": 128000,
          "x-sn-max-bytes": 128000,
          "pattern": "^(?:[^$\\x00]|\\$+(?:\\{[A-Za-z_][A-Za-z0-9_]*\\}|[^$\\{\\x00]))*\\$*$"
        }
      }
    },
    {
      "title": "API Profile",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "driver",
        "model",
        "timeout"
      ],
      "properties": {
        "type": {
          "description": "Selects the API Profile domain.",
          "const": "api"
        },
        "driver": {
          "description": "Selects the Provider wire protocol adapter.",
          "enum": [
            "openai-chat-completions",
            "openai-responses",
            "openai-codex-responses",
            "anthropic-messages"
          ]
        },
        "endpoint": {
          "description": "Complete Provider endpoint used unchanged, including a root path. Generic OpenAI drivers allow HTTP only on loopback; all other destinations require HTTPS. Mutually exclusive with base_url.",
          "type": "string",
          "format": "uri",
          "x-sn-url-semantics": "absolute HTTPS URL with host, or generic OpenAI HTTP loopback; no userinfo or fragment; loopback and URL syntax checked by Go loader",
          "pattern": "^https?://[^/?#@]+(?:/[^?#]*)?(?:\\?[^#]*)?$"
        },
        "base_url": {
          "description": "Complete Provider API prefix including any version path. HTTPS is required except HTTP loopback for the generic OpenAI drivers. Runtime appends only chat/completions, responses, or messages; it never inserts or detects a version.",
          "type": "string",
          "format": "uri",
          "x-sn-url-semantics": "absolute HTTPS URL with host, or generic OpenAI HTTP loopback; optional path prefix, no userinfo, query or fragment; loopback checked by Go loader",
          "pattern": "^https?://[^/?#@]+(?:/[^?#]*)?$"
        },
        "model": {
          "description": "Provider model identifier sent in each request.",
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "x-sn-max-bytes": 1024,
          "pattern": "\\S"
        },
        "headers": {
          "description": "HTTP headers applied to every Provider request. Values may use ${VAR} references that the runtime expands from the environment; openai-chat-completions and openai-responses prefix a bare Authorization value with the Bearer scheme.",
          "type": "object",
          "maxProperties": 128,
          "propertyNames": {
            "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 8192,
            "x-sn-max-bytes": 8192,
            "pattern": "^[^\\r\\n\\x00]*$"
          }
        },
        "parameters": {
          "description": "Default generation parameters and upstream response mode. Generation defaults apply when a request does not override them; stream is Profile-only.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "extra_body": {
              "description": "Native Provider request option defaults, shallow-merged with ModelRequest.options.extra_body. Values including null, zero and false are forwarded unchanged at the HTTP body top level; model support and value validation belong to the upstream service. This is not a replacement for canonical messages, tools, identity or lifecycle fields.",
              "type": ["object", "null"],
              "x-sn-max-bytes": 1048576,
              "propertyNames": {
                "minLength": 1,
                "maxLength": 256,
                "x-sn-max-bytes": 256,
                "pattern": "^[^\\x00]+$",
                "not": {"enum": ["model", "messages", "input", "system", "instructions", "tools", "stream", "max_tokens", "max_completion_tokens", "max_output_tokens", "temperature", "top_p", "stop", "stop_sequences", "background", "conversation", "previous_response_id", "context_management", "container", "mcp_servers", "modalities", "audio", "n", "functions", "function_call"]}
              },
              "additionalProperties": true
            },
            "stream": {
              "description": "Upstream response mode: true requests SSE; false requests JSON. Omission defaults to true. Independent of CLI --stream output framing.",
              "type": "boolean",
              "default": true
            },
            "max_tokens": {
              "description": "Default maximum output tokens; adapters map it to their native wire field.",
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "temperature": {
              "description": "Default sampling temperature shared by API drivers.",
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 2
            },
            "top_p": {
              "description": "Optional default nucleus sampling probability; target models or compatible services may reject unsupported values.",
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "stop_sequences": {
              "description": "Optional default stop sequences; adapters map them to their native wire field and target model support may vary.",
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "x-sn-max-bytes": 1024,
                "pattern": "^[^\\x00]+$"
              }
            }
          }
        },
        "timeout": {
          "description": "Timeout for one Provider attempt as a Go duration, greater than zero and no more than 24h.",
          "type": "string",
          "x-sn-duration-min": "1ns",
          "x-sn-duration-max": "24h",
          "allOf": [
            {
              "pattern": "^\\+?(?:(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:ns|us|µs|μs|ms|s|m|h))+$"
            },
            {
              "pattern": "[1-9]"
            }
          ]
        },
        "context": {
          "description": "Local Session projection policy; these fields are not sent to the Provider.",
          "type": "object",
          "additionalProperties": false,
          "x-sn-managed-input-budget-minimum": 2,
          "properties": {
            "window_tokens": {
              "description": "Local Session context window; zero or omission uses the conservative default.",
              "default": 32768,
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "reserved_output_tokens": {
              "description": "Local Session output reservation; zero or omission defaults to 8192 and never undercuts a configured output limit.",
              "default": 8192,
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "keep_recent_turns": {
              "description": "Minimum recent turns retained verbatim when summary_enabled compacts overflowing history. Zero or omission floors to 1. Frozen into snapshots.",
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "summary_enabled": {
              "description": "When true, the Session projection compacts overflowing history by dropping leading turns (keeping keep_recent_turns recent turns) instead of failing with context_overflow. The first increment is deterministic truncation; the dropped range is grounded by a per-session summaries.jsonl digest. Frozen into execution snapshots, so changing it mid-run fails closed.",
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "endpoint"
          ],
          "not": {
            "required": [
              "base_url"
            ]
          }
        },
        {
          "required": [
            "base_url"
          ],
          "not": {
            "required": [
              "endpoint"
            ]
          }
        }
      ],
      "allOf": [
        {
          "if": {"properties": {"driver": {"const": "openai-codex-responses"}}, "required": ["driver"]},
          "then": {
            "properties": {
              "endpoint": {"const": "https://chatgpt.com/backend-api/codex/responses"},
              "base_url": {"const": "https://chatgpt.com/backend-api"},
              "headers": {"maxProperties": 0},
              "parameters": {"properties": {
                "stream": {"const": true},
                "extra_body": {"properties": {"store": {"const": false}}},
                "max_tokens": {"type": "null"},
                "top_p": {"type": "null"},
                "stop_sequences": {"maxItems": 0}
              }}
            }
          }
        },
        {
          "if": {"properties": {"driver": {"const": "openai-responses"}}, "required": ["driver"]},
          "then": {"properties": {"parameters": {"properties": {"stop_sequences": {"maxItems": 0}}}}}
        },
        {
          "if": {
            "properties": {
              "driver": {
                "const": "anthropic-messages"
              }
            },
            "required": [
              "driver"
            ]
          },
          "then": {
            "required": [
              "parameters"
            ],
            "properties": {
              "endpoint": {"pattern": "^https://[^/?#@]+/[^?#]+(?:\\?[^#]*)?$"},
              "base_url": {"pattern": "^https://[^/?#@]+(?:/[^?#]*)?$"},
              "parameters": {
                "required": [
                  "max_tokens"
                ],
                "properties": {
                  "max_tokens": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      ]
    }
  ]
}
