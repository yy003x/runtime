{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yy003x/runtime/resources/schema/profile.schema.json",
  "title": "Runtime Profile",
  "oneOf": [
    {
      "title": "CLI Profile",
      "type": "object",
      "additionalProperties": false,
      "x-sn-adapter-grammar": true,
      "required": [
        "type",
        "command"
      ],
      "properties": {
        "type": {
          "const": "cli"
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "x-sn-max-bytes": 4096,
          "allOf": [
            {
              "pattern": "^[^\\x00]+$"
            },
            {
              "pattern": "(?:^|/)(?:codex|claude)$"
            }
          ]
        },
        "args": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "string",
            "maxLength": 128000,
            "x-sn-max-bytes": 128000,
            "pattern": "^(?:[^$\\x00]|\\$+(?:\\{[A-Za-z_][A-Za-z0-9_]*\\}|[^$\\{\\x00]))*\\$*$"
          }
        },
        "env": {
          "type": "object",
          "maxProperties": 1024,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^=\\x00]*[^=\\x00\\s][^=\\x00]*$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128000,
            "x-sn-max-bytes": 128000,
            "pattern": "^(?:[^$\\x00]|\\$+(?:\\{[A-Za-z_][A-Za-z0-9_]*\\}|[^$\\{\\x00]))*\\$*$"
          }
        },
        "model": {
          "type": "string",
          "maxLength": 128000,
          "x-sn-max-bytes": 128000,
          "pattern": "^[^\\x00]*$"
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "prompt": {
          "type": "string",
          "maxLength": 128000,
          "x-sn-max-bytes": 128000,
          "pattern": "^[^\\x00]*$"
        },
        "exec": {
          "type": "boolean",
          "default": false
        },
        "cwd": {
          "type": "string",
          "maxLength": 128000,
          "x-sn-max-bytes": 128000,
          "pattern": "^(?:[^$\\x00]|\\$+(?:\\{[A-Za-z_][A-Za-z0-9_]*\\}|[^$\\{\\x00]))*\\$*$"
        }
      }
    },
    {
      "title": "API Profile",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "driver",
        "model",
        "auth",
        "timeout"
      ],
      "properties": {
        "type": {
          "description": "Selects the API Profile domain.",
          "const": "api"
        },
        "driver": {
          "description": "Selects the Provider wire protocol adapter.",
          "enum": [
            "openai-compatible",
            "anthropic-compatible"
          ]
        },
        "endpoint": {
          "description": "Optional complete Provider HTTPS endpoint; mutually exclusive with base_url.",
          "type": "string",
          "format": "uri",
          "x-sn-url-semantics": "absolute HTTPS URL with host, explicit non-root path, no userinfo, no fragment",
          "pattern": "^https://[^/?#@]+/[^?#]+(?:\\?[^#]*)?$"
        },
        "base_url": {
          "description": "Optional Provider HTTPS base URL; Runtime appends the driver default API path and preserves an existing path prefix.",
          "type": "string",
          "format": "uri",
          "x-sn-url-semantics": "absolute HTTPS URL with host, optional path prefix, no userinfo, query, or fragment",
          "pattern": "^https://[^/?#@]+(?:/[^?#]*)?$"
        },
        "model": {
          "description": "Provider model identifier sent in each request.",
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "x-sn-max-bytes": 1024,
          "pattern": "\\S"
        },
        "auth": {
          "description": "Environment-backed authentication header configuration; no secret value is stored here.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "header",
            "from_env"
          ],
          "properties": {
            "header": {
              "description": "HTTP header that carries the resolved authentication value.",
              "type": "string",
              "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
            },
            "scheme": {
              "description": "Optional authentication prefix such as Bearer; omission sends the secret directly.",
              "type": "string",
              "pattern": "^(?:[!#$%&'*+.^_`|~0-9A-Za-z-]+)?$"
            },
            "from_env": {
              "description": "Environment variable containing the authentication secret.",
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          }
        },
        "headers": {
          "description": "Optional non-secret literal HTTP headers; authentication and sensitive headers are forbidden.",
          "type": "object",
          "maxProperties": 128,
          "x-sn-forbid-auth-header-match": true,
          "propertyNames": {
            "allOf": [
              {
                "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
              },
              {
                "not": {
                  "pattern": "^(?:[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Pp][Rr][Oo][Xx][Yy]-[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Xx]-[Aa][Pp][Ii]-[Kk][Ee][Yy]|[Aa][Pp][Ii]-[Kk][Ee][Yy]|[Cc][Oo][Oo][Kk][Ii][Ee]|[Ss][Ee][Tt]-[Cc][Oo][Oo][Kk][Ii][Ee])$"
                }
              }
            ]
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 8192,
            "x-sn-max-bytes": 8192,
            "allOf": [
              {
              "pattern": "^[^\\r\\n\\x00]*$"
              },
              {
                "not": {
                  "pattern": "\\$\\{"
                }
              }
            ]
          }
        },
        "defaults": {
          "description": "Provider-neutral default generation options applied when a request does not override them.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_tokens": {
              "description": "Default maximum output tokens; adapters map it to their native wire field.",
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "temperature": {
              "description": "Default sampling temperature shared by API drivers.",
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 2
            },
            "top_p": {
              "description": "Optional default nucleus sampling probability; target models or compatible services may reject unsupported values.",
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "stop_sequences": {
              "description": "Optional default stop sequences; adapters map them to their native wire field and target model support may vary.",
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "x-sn-max-bytes": 1024,
                "pattern": "^[^\\x00]+$"
              }
            }
          }
        },
        "timeout": {
          "description": "Timeout for one Provider attempt as a Go duration, greater than zero and no more than 24h.",
          "type": "string",
          "x-sn-duration-min": "1ns",
          "x-sn-duration-max": "24h",
          "allOf": [
            {
              "pattern": "^\\+?(?:(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:ns|us|µs|μs|ms|s|m|h))+$"
            },
            {
              "pattern": "[1-9]"
            }
          ]
        },
        "context": {
          "description": "Local Session projection policy; these fields are not sent to the Provider.",
          "type": "object",
          "additionalProperties": false,
          "x-sn-input-budget-minimum": 2,
          "properties": {
            "window_tokens": {
              "description": "Local Session context window; zero or omission uses the conservative default.",
              "default": 32768,
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "reserved_output_tokens": {
              "description": "Local Session output reservation; zero or omission defaults to 8192 and never undercuts a configured output limit.",
              "default": 8192,
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "keep_recent_turns": {
              "description": "Accepted, validated and frozen into snapshots, but current Session projection does not yet trim history with it.",
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "summary_enabled": {
              "description": "Accepted and frozen into snapshots, but current Session does not yet perform history summarization.",
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "endpoint"
          ],
          "not": {
            "required": [
              "base_url"
            ]
          }
        },
        {
          "required": [
            "base_url"
          ],
          "not": {
            "required": [
              "endpoint"
            ]
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "driver": {
                "const": "anthropic-compatible"
              }
            },
            "required": [
              "driver"
            ]
          },
          "then": {
            "required": [
              "defaults"
            ],
            "properties": {
              "defaults": {
                "required": [
                  "max_tokens"
                ],
                "properties": {
                  "max_tokens": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      ]
    }
  ]
}
