{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yy003x/runtime/resources/schema/profile.schema.json",
  "title": "Runtime Profile",
  "oneOf": [
    {
      "title": "CLI Profile",
      "type": "object",
      "additionalProperties": false,
      "x-sn-adapter-grammar": true,
      "required": [
        "type",
        "command"
      ],
      "properties": {
        "type": {
          "const": "cli"
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "x-sn-max-bytes": 4096,
          "allOf": [
            {
              "pattern": "^[^\\x00]+$"
            },
            {
              "pattern": "(?:^|/)(?:codex|claude)$"
            }
          ]
        },
        "args": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "string",
            "maxLength": 98304,
            "x-sn-max-bytes": 98304,
            "pattern": "^(?:[^$\\x00]|\\$+(?:\\{[A-Za-z_][A-Za-z0-9_]*\\}|[^$\\{\\x00]))*\\$*$"
          }
        },
        "env": {
          "type": "object",
          "maxProperties": 1024,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^=\\x00]*[^=\\x00\\s][^=\\x00]*$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 98304,
            "x-sn-max-bytes": 98304,
            "pattern": "^(?:[^$\\x00]|\\$+(?:\\{[A-Za-z_][A-Za-z0-9_]*\\}|[^$\\{\\x00]))*\\$*$"
          }
        },
        "model": {
          "type": "string",
          "maxLength": 98304,
          "x-sn-max-bytes": 98304,
          "pattern": "^[^\\x00]*$"
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "prompt": {
          "type": "string",
          "maxLength": 98304,
          "x-sn-max-bytes": 98304,
          "pattern": "^[^\\x00]*$"
        },
        "exec": {
          "type": "boolean",
          "default": false
        },
        "cwd": {
          "type": "string",
          "maxLength": 98304,
          "x-sn-max-bytes": 98304,
          "pattern": "^(?:[^$\\x00]|\\$+(?:\\{[A-Za-z_][A-Za-z0-9_]*\\}|[^$\\{\\x00]))*\\$*$"
        }
      }
    },
    {
      "title": "API Profile",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "driver",
        "endpoint",
        "model",
        "auth",
        "timeout"
      ],
      "properties": {
        "type": {
          "const": "api"
        },
        "driver": {
          "enum": [
            "openai-compatible",
            "anthropic-compatible"
          ]
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "x-sn-url-semantics": "absolute HTTPS URL with host, explicit non-root path, no userinfo, no fragment",
          "pattern": "^https://[^/?#@]+/[^?#]+(?:\\?[^#]*)?$"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "x-sn-max-bytes": 1024,
          "pattern": "\\S"
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "header",
            "from_env"
          ],
          "properties": {
            "header": {
              "type": "string",
              "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
            },
            "scheme": {
              "type": "string",
              "pattern": "^(?:[!#$%&'*+.^_`|~0-9A-Za-z-]+)?$"
            },
            "from_env": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          }
        },
        "headers": {
          "type": "object",
          "maxProperties": 128,
          "x-sn-forbid-auth-header-match": true,
          "propertyNames": {
            "allOf": [
              {
                "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
              },
              {
                "not": {
                  "pattern": "^(?:[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Pp][Rr][Oo][Xx][Yy]-[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Xx]-[Aa][Pp][Ii]-[Kk][Ee][Yy]|[Aa][Pp][Ii]-[Kk][Ee][Yy]|[Cc][Oo][Oo][Kk][Ii][Ee]|[Ss][Ee][Tt]-[Cc][Oo][Oo][Kk][Ii][Ee])$"
                }
              }
            ]
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 8192,
            "x-sn-max-bytes": 8192,
            "allOf": [
              {
              "pattern": "^[^\\r\\n\\x00]*$"
              },
              {
                "not": {
                  "pattern": "\\$\\{"
                }
              }
            ]
          }
        },
        "defaults": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_completion_tokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "max_tokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "temperature": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 2
            }
          }
        },
        "timeout": {
          "type": "string",
          "x-sn-duration-min": "1ns",
          "x-sn-duration-max": "24h",
          "allOf": [
            {
              "pattern": "^\\+?(?:(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:ns|us|µs|μs|ms|s|m|h))+$"
            },
            {
              "pattern": "[1-9]"
            }
          ]
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "x-sn-input-budget-minimum": 2,
          "properties": {
            "window_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "reserved_output_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "keep_recent_turns": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "summary_enabled": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "driver": {
                "const": "openai-compatible"
              }
            },
            "required": [
              "driver"
            ]
          },
          "then": {
            "properties": {
              "defaults": {
                "not": {
                  "properties": {
                    "max_tokens": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "max_tokens"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "driver": {
                "const": "anthropic-compatible"
              }
            },
            "required": [
              "driver"
            ]
          },
          "then": {
            "required": [
              "defaults"
            ],
            "properties": {
              "defaults": {
                "required": [
                  "max_tokens"
                ],
                "properties": {
                  "max_tokens": {
                    "type": "integer"
                  }
                },
                "not": {
                  "properties": {
                    "max_completion_tokens": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "max_completion_tokens"
                  ]
                }
              }
            }
          }
        }
      ]
    }
  ]
}
