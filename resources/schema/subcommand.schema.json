{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yy003x/runtime/resources/schema/subcommand.schema.json",
  "title": "Runtime Top-Level Subcommand",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile"
  ],
  "properties": {
    "profile": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "maxLength": 128
    }
  }
}
