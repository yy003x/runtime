{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yy003x/runtime/resources/schema/tool.schema.json",
  "title": "Runtime Tool",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "effect",
    "description",
    "input_schema",
    "executor"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "effect": {
      "const": "read_only"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1048576
    },
    "input_schema": {
      "type": "object"
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "endpoint",
        "remote_tool",
        "headers",
        "timeout",
        "max_response_bytes"
      ],
      "properties": {
        "type": {
          "const": "mcp"
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "remote_tool": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "timeout": {
          "type": "string",
          "minLength": 1
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 8388608
        }
      }
    }
  }
}
