{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yy003x/runtime/resources/schema/runtime.schema.json",
  "title": "Runtime vNext Configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "driver": {
          "enum": ["ghostty", "iterm2"],
          "default": "ghostty"
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tools": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "read_file",
              "list_directory",
              "write_file",
              "exec_command"
            ]
          },
          "default": ["read_file", "list_directory"]
        },
        "workspace_roots": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/"
          }
        },
        "max_rounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128,
          "default": 16
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024,
          "default": 64
        },
        "max_total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "max_wall_time": {
          "type": "string",
          "default": "15m"
        }
      }
    },
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "default": 1
        },
        "poll_interval": {
          "type": "string",
          "default": "250ms"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "settled_retention": {
          "type": "string",
          "default": "168h"
        }
      }
    }
  }
}
