{
  "schema_version": 1,
  "default_provider": "cx",
  "runtime": {
    "default_sandbox": "read-only",
    "default_timeout_seconds": 1800
  },
  "paths": {
    "sessions_root": "runs/global/sn-cli/session"
  },
  "native": {
    "project": "agent",
    "profiles": {
      "codex": "tcx",
      "claude": "tcc"
    }
  },
  "tools": {},
  "update": {
    "enabled": true,
    "check_interval_hours": 24,
    "ref": "main",
    "state_file": "runs/global/sn-cli/state/current/update-check.json",
    "install_script": "scripts/install-sn-cli.sh",
    "repo_url": "https://github.com/yy003x/runtime.git"
  }
}
