{
  "agent": {
    "tools": [
      "read_file",
      "list_directory",
      "web_search",
      "web_fetch"
    ],
    "max_rounds": 16,
    "max_tool_calls": 64,
    "max_wall_time": "15m"
  },
  "scheduler": {
    "workers": 1,
    "poll_interval": "250ms"
  },
  "run": {
    "settled_retention": "168h",
    "reaper": {
      "interval": "5m",
      "paused_ttl": "30m",
      "needs_reconciliation_ttl": "24h"
    }
  },
  "tmux": {
    "server_mode": "default"
  }
}
